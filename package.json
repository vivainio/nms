{
  "name": "nms",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "A fast, browsable No Man's Sky crafting and refining reference",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:fetch": "python3 scripts/fetch_data.py",
    "data:build": "python3 scripts/build_data.py",
    "data:verify": "python3 scripts/verify_data.py",
    "data": "npm run data:build && npm run data:verify"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
